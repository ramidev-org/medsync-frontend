# Demo / Prototype flags
EXPO_PUBLIC_DEMO=true

# UI role switching (doctor | reception)
EXPO_PUBLIC_ROLE=reception

# Demo helper: make the demo doctor act as clinic admin
EXPO_PUBLIC_CLINIC_ADMIN=false

# Supabase (required for real mode)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# LiveKit
EXPO_PUBLIC_LIVEKIT_URL=
EXPO_PUBLIC_LIVEKIT_TOKEN_ENDPOINT=http://127.0.0.1:3001/api/livekit-token
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Peer server (staff-to-staff calling)
EXPO_PUBLIC_PEER_SERVER_HOST=127.0.0.1
EXPO_PUBLIC_PEER_SERVER_PORT=9000
EXPO_PUBLIC_PEER_SERVER_PATH=/myapp
EXPO_PUBLIC_PEER_SERVER_SECURE=false
EXPO_PUBLIC_PEER_SERVER_KEY=peerjs

# Public web URL - used to build shareable links (e.g. staff invites) on
# platforms where window.location isn't available (native mobile).
EXPO_PUBLIC_WEB_APP_URL=http://localhost:8081
