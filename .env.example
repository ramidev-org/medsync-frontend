# Demo / Prototype flags
EXPO_PUBLIC_DEMO=true

# UI role switching (doctor | reception)
EXPO_PUBLIC_ROLE=reception

# Demo helper: make the demo doctor act as clinic admin
EXPO_PUBLIC_CLINIC_ADMIN=false

# Supabase (required for real mode)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OHIF Viewer URL (web embedding + external launch fallback)
EXPO_PUBLIC_OHIF_VIEWER_URL=https://viewer.ohif.org/

# Optional: override OHIF per speciality (falls back to EXPO_PUBLIC_OHIF_VIEWER_URL)
EXPO_PUBLIC_OHIF_VIEWER_URL_GENERAL=
EXPO_PUBLIC_OHIF_VIEWER_URL_CARDIOLOGY=
EXPO_PUBLIC_OHIF_VIEWER_URL_DERMATOLOGY=
EXPO_PUBLIC_OHIF_VIEWER_URL_GYNECOLOGY=
EXPO_PUBLIC_OHIF_VIEWER_URL_PEDIATRICS=
EXPO_PUBLIC_OHIF_VIEWER_URL_DENTISTRY=

# Optional per-specialty 3D tools (embeddable URLs)
EXPO_PUBLIC_TOOL_DENTISTRY_URL=https://sketchfab.com/models/768c0ac4f5864e0a9d9fea3296f468fe/embed
EXPO_PUBLIC_TOOL_CARDIOLOGY_URL=https://sketchfab.com/models/26b5044d922340988cd3d13ca0f0d176/embed
